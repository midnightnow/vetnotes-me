      "signoff": "finalised",
      "kind": "consult",
      "problem": "Left hindlimb lameness",
      "sections": [
        {
          "heading": "Subjective",
          "text": "Acute non-weight-bearing L hind after chasing ball on 26/10. Owner reports no improvement on rest."
        },
        {
          "heading": "Objective",
          "text": "T 38.6. Grade 4/5 lameness LH. Positive cranial drawer and tibial thrust L stifle. Medial buttress palpable. R stifle stable."
        },
        {
          "heading": "Assessment",
          "text": "Suspect L cranial cruciate ligament rupture."
        },
        {
          "heading": "Plan",
          "text": "Meloxicam 0.1 mg/kg PO SID. Strict rest. Refer for orthopaedic assessment, TPLO consult."
        }
      ],
      "sha256": "dd97ce573af1d2ff26c8414dd0609b2e139d7074f794a096453b35acee384339"
    }
